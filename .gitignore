# Runtime artifacts generated by the PDD pipelines (not source).
# Root-anchored deliberately: an unanchored `.docs/` also swallowed every
# eval fixture's frozen `.docs/` input (evals/contract/*/fixture/.docs/),
# which meant no fixture doc was ever actually in version control - the
# "frozen" inputs existed only as ignored files on the author's machine.
/.docs/
scratch/

# Preserved working copies of failing eval runs (diagnostic, transient)
evals/results/artifacts/

# Python bytecode
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Per-run eval transcripts and artifacts (large; results.jsonl is the record of truth)
evals/results/transcripts/

# Antigravity eval harness run state: per-run start markers and in-place fixture
# copies made by `evals/antigravity/run.py start --in-place` (results.jsonl is the
# record of truth; both are disposable per-machine data)
evals/antigravity/runs/
evals/runs/
eval-runs/
